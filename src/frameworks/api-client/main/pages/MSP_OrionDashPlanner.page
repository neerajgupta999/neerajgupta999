<apex:page controller="MSP_OrionVFController" action="{!getDashboardLinkPlanner}">
    <apex:form >
        <apex:pageMessages />
    </apex:form>
    <style>
        .parent-containerPlanner {
            flex-grow: 1;
            overflow-y: hidden;
            height: 98vh;
        }
    </style>

    <div class="parent-containerPlanner">
        <apex:iframe id="dynamicIframePlanner"  src="{!HTMLENCODE(JSENCODE(url))}" width="100%" height="100%" scrolling="false"  frameborder="false" />
    </div>

</apex:page>